# ── App ──────────────────────────────────────────────
app_env=development

# ── Internal Token（Cloud Tasks worker 驗證，必填）────
# 本機開發可用任意值；production 請用隨機字串
INTERNAL_TOKEN=dev-internal-token-change-in-prod
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

#── Database ─────────────────────────────────────────
# 本機開發用 TCP 連線
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rag_db

# Cloud Run（Unix socket）：
# DATABASE_URL=postgresql+asyncpg://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
DB_POOL_SIZE_MIN=5
DB_POOL_SIZE_MAX=20
DB_POOL_TIMEOUT=30

# ── GCS ──────────────────────────────────────────────
GCS_BUCKET_NAME=your-rag-bucket
GCS_PROJECT=your-gcp-project-id

# ── Cloud Tasks ──────────────────────────────────────
CLOUD_TASKS_PROJECT=your-gcp-project-id
CLOUD_TASKS_LOCATION=asia-east1
CLOUD_TASKS_QUEUE=onceagain-rag-ingestion
CLOUD_TASKS_MAX_RETRIES=3
WORKER_BASE_URL=http://localhost:8000

# ── Vertex AI / Gemini ───────────────────────────────
# 本機開發：gcloud auth application-default login
# Cloud Run：Service Account 自動處理
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=google/gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_PDF_TIMEOUT_SEC=120
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── JWT ──────────────────────────────────────────────
# 必填，production 請用：openssl rand -hex 32
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── Qdrant（Phase 4）────────────────────────────────
QDRANT_HOST=your-qdrant-vm-ip
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=public_rag_chunks
