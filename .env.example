# ── App ──────────────────────────────────────────────
APP_ENV=development
INTERNAL_TOKEN=dev-internal-token-change-in-prod

# ── Database ─────────────────────────────────────────
# 本機開發用 TCP，Cloud Run 用 Unix socket
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rag_db
# Cloud Run:
# DATABASE_URL=postgresql+asyncpg://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE

# ── GCS ──────────────────────────────────────────────
GCS_BUCKET_NAME=your-rag-bucket

# ── Document AI ──────────────────────────────────────
DOCUMENT_AI_PROJECT_ID=your-gcp-project
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-processor-id

# ── Cloud Tasks ──────────────────────────────────────
CLOUD_TASKS_PROJECT=your-gcp-project
CLOUD_TASKS_LOCATION=asia-east1
CLOUD_TASKS_QUEUE=rag-ingestion
WORKER_BASE_URL=http://localhost:8000

# ── Vertex AI / Gemini ───────────────────────────────
VERTEX_AI_PROJECT=your-gcp-project
VERTEX_AI_LOCATION=us-central1
# 本機開發：GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
